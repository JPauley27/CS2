grid_size= 5
ships= {'battle_ship':1}
def random_row():
    return random.randint(0, grid_size -1)
def random_col():
    return random.randint(0, grid_size -1)
grid= [['.', '.', '.', '.', '.',],
       ['.', '.', '.', '.', '.',],
       ['.', '.', '.', '.', '.',],
       ['.', '.', '.', '.', '.',],
       ['.', '.', '.', '.', '.',],]
player_grid = [['.']* grid_size for _ in range(grid_size)]
computer_grid = [['.']* grid_size for _ in range(grid_size)]
def place_ship(size, ship, grid):
    while True:
        row = random_row()
        col = random_col()
        is_vertical = random.choice(True, False)
        if is_vertical:
            if row + size > grid_size:
                continue
            if '.' not in [grid[row+i][col] for i in range(size)]:
                continue
            for i in range(size):
                grid[row+i][col] = ship[0]
        else:
            if col + size > grid_size:
                continue
            if '.' not in [grid[row][col+i]for i in range(size)]:
                continue
            for i in range(size):
                grid[row][col+i] = ship[0]

        break
    return True
def place_ships(grid):
    for ship,size in ships.items():
        while True:
            placed = place_ship(size, ship, grid)
            if placed:
                break
    return grid
def fire(row,col,grid):
    mark = grid[row][col]
    if mark == 'x' or mark == '-':
        print ("\nYou've already fired at this spot. Try a new one.")
        return
    elif mark != '.':
        print(f"\n Hit!!! {mark} Ship destroyed!!!")
        grid[row][col]=='x'
        return mark
    else:
        print("\n You missed.")
        grid[row][col] = "-"
        return False
def print_board(grid,war=True):
    print(' '+' '.join(map(str, range(grid_size))))
    for i, row in enumerate(grid):
        if war:
            row = ['.' if cell != 'X' else 'X' for cell in row]
        print(f'{i} ' + ' '.join(row))
def help_print():
    print("Welcome to BattleShip")
    print("You will be competing against a computer, on a five by five board, where both you and the computer place four ships, of equal one dot size, on the board.")
    print("If a ship is hit a 'x' will display in that spot, if the ship is missed a '-' will display.")
    print("Good Luck")
    
def main():
    help_print()
    player_grid = [['.'] * grid_size for _ in range(grid_size)]
    player_grid = place_ships(player_grid)
    computer_grid = [['.'] * grid_size for _ in range(grid_size)]
    computer_grid = place_ships(computer_grid)
    ships_remaining = len(ships)
    while ships_remaining > 0:
        print("(Type 'quit' to exit the game)")
        action = input("Enter row (or 'quit' to exit), followed by column to fire at: ")
        if action.lower().strip() == "quit":
            break
        coordinates = action.split
        if len(coordinates) != 2:
            print("\n invalid coordinates, please enter new ones")
            continue
        try:
            row, col = map(int, coordinates)
            if row < 0 or row >= grid_size or col < 0 or col >= grid_size:
                print("\nInvalid coordinates, please enter new ones.")
                continue
        except ValueError:
            print("\n invalid input, please enter the coordinates of one row and one column")
            continue
        hit_ship = fire(row, col, computer_grid)
        if hit_ship:
            ship_name = [name for name, size in ships.items() if name[0] == hit_ship][0]
            if hit_ship not in ''.join([''.join(row) for row in computer_grid]):
                print("\n You have hit the enemy ship!!! Great Job")
                ships_remaining =-1
        print("\n Your Grid:")
        print_board(player_grid,war=False)
        print("\n Computer Grid:")
        print_board(computer_grid)
    if action.lower().strip() == "quit":
        print("\n You decided to quit BattleShip. How dare you quit my game that I coded.")
    elif ships_remaining != 0 and action.lower().strip() == "quit":
        print("\n You ran out of turns and didn't shoot all of the enemy ships.")
    else:
        print("\n You shot down all of the enemy ships, Good Job!!!")
if __name__ == "__main__":
    main()
